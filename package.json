{
  "name": "cognirav-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w server && npm run build -w web",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w web\"",
    "lint": "npm run lint -w web",
    "type-check": "npm run type-check -w server"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "@vercel/node": {
      "undici": "6.28.1",
      "path-to-regexp": "6.3.0",
      "@vercel/static-config": {
        "ajv": "8.20.0"
      }
    },
    "vite": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@vercel/node": "^12.0.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "vite": "^5.3.4"
  }
}
