{
  "name": "cognirav-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w server && npm run build -w web",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w web\"",
    "lint": "npm run lint -w web",
    "type-check": "npm run type-check -w server"
  },
  "devDependencies": {
    "@vercel/node": "^12.0.3",
    "concurrently": "^9.1.2"
  }
}
